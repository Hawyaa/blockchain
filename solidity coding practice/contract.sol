pragma solidity ^0.8.0;

contract Contract {
    // Variable 'a' is public and initialized to true
    bool public a = true;

    // Variable 'b' is public and initialized to false
    // Note: 'b' would be false by default even if we didn't assign it, 
    // but explicit assignment is fine for your goal!
    bool public b = false;
}